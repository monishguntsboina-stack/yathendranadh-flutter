rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check user role from users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // USERS COLLECTION
    // Users can read/write their own document; Admins can read all users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'admin');
    }
    
    // FOODS COLLECTION
    // Everyone can view menu; Only Admin can modify menu
    match /foods/{foodId} {
      allow read: if true;
      allow write: if isAuthenticated() && getUserRole() == 'admin';
    }
    
    // TABLES COLLECTION
    // Everyone can view tables; Waiters, Kitchen, and Admin can update
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isAuthenticated() && getUserRole() in ['waiter', 'kitchen', 'admin'];
    }
    
    // ORDERS COLLECTION
    // Customers can create orders and read their own orders
    // Kitchen and Waiter can view all orders and update statuses
    // Admin has full management access
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated() && getUserRole() in ['customer', 'waiter', 'kitchen', 'admin'];
      allow delete: if isAuthenticated() && getUserRole() == 'admin';
    }
  }
}
